@model List<EtherApp.Controllers.JobMatchResult>
@{
    ViewData["Title"] = "Job Matches";
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
            🎯 Job Match Finder
        </h1>
        <p class="text-gray-500 mt-1">
            Enter a skill or job title to find matching roles.
        </p>
    </div>

    <form asp-controller="JobMatch" asp-action="Index" method="post" class="bg-white dark:bg-gray-800 rounded-xl shadow p-6 border border-gray-100 dark:border-gray-700 mb-8">
        <label for="skillInput" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Skill / Job Title
        </label>
        <div class="flex gap-3">
            <input
                id="skillInput"
                name="skillInput"
                type="text"
                value="@ViewBag.Skills"
                class="flex-1 rounded-lg border border-gray-300 dark:border-gray-600 px-4 py-2 bg-white dark:bg-gray-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Example: DevOps, Python, Data Engineer" />
            <button type="submit" class="px-5 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">
                Search
            </button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="space-y-4">
            @for (int i = 0; i < Model.Count; i++)
            {
                var job = Model[i];
                var medal = i == 0 ? "🥇" : i == 1 ? "🥈" : i == 2 ? "🥉" : "⭐";

                <div class="bg-white dark:bg-gray-800 rounded-xl shadow p-6 border border-gray-100 dark:border-gray-700">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-lg font-semibold text-gray-800 dark:text-white">
                            @medal @job.Job_Title
                        </h2>
                        <span class="text-sm font-bold px-3 py-1 rounded-full @(job.Match_Score >= 40 ? "bg-green-100 text-green-700" : job.Match_Score >= 25 ? "bg-yellow-100 text-yellow-700" : "bg-red-100 text-red-700")">
                            @job.Match_Score% Match
                        </span>
                    </div>

                    <div class="w-full bg-gray-200 rounded-full h-2 mb-3">
                        <div class="h-2 rounded-full bg-gradient-to-r from-blue-400 to-blue-600"
                             style="width: @(Math.Min(job.Match_Score, 100))%">
                        </div>
                    </div>

                    <p class="text-sm text-gray-500">
                        <span class="font-medium">Required Skills:</span> @job.Skills
                    </p>
                </div>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ViewBag.Skills as string))
    {
        <div class="text-center py-16 text-gray-400">
            <p class="text-5xl mb-4">🔍</p>
            <p class="text-lg">No matches found for your query.</p>
        </div>
    }
</div>