@using EtherApp.ViewModels.Admin
@model List<Post>

<main id="site__main" class="2xl:ml-0 xl:ml-0 p-4 h-100 mt-[--m-top] bg-[#eadbf0]">
    <div class="max-w-[1200px] mx-auto" id="js-oversized">
        <div class="mx-auto flex-1">
            <div class="bg-white rounded-xl shadow-sm p-5 border border-[#cabeca] mb-6">
                <h1 class="text-2xl font-bold text-[#4a3256] mb-2">Admin Dashboard</h1>
                <p class="text-[#4a3256]/80">Manage users, content, and moderation</p>
            </div>
            
            <!-- Tab Navigation -->
            <div class="bg-white rounded-xl shadow-sm border border-[#cabeca] mb-6 overflow-hidden">
                <nav class="border-b border-[#cabeca]">
                    <div class="flex" uk-switcher="connect: #admin-tabs; animation: uk-animation-fade">
                        <button class="py-4 px-6 bg-transparent hover:bg-[#eadbf0]/30 text-[#4a3256] font-medium text-center flex-1 border-r border-[#cabeca] focus:outline-none"
                                type="button">
                            <div class="flex justify-center items-center">
                                <ion-icon name="people-outline" class="text-xl mr-2"></ion-icon>
                                User Management
                            </div>
                        </button>
                        <button class="py-4 px-6 bg-transparent hover:bg-[#eadbf0]/30 text-[#4a3256] font-medium text-center flex-1 border-r border-[#cabeca] focus:outline-none"
                                type="button">
                            <div class="flex justify-center items-center">
                                <ion-icon name="flag-outline" class="text-xl mr-2"></ion-icon>
                                Reported Posts
                            </div>
                        </button>
                        <button class="py-4 px-6 bg-transparent hover:bg-[#eadbf0]/30 text-[#4a3256] font-medium text-center flex-1 border-r border-[#cabeca] focus:outline-none"
                                type="button">
                            <div class="flex justify-center items-center">
                                <ion-icon name="shield-outline" class="text-xl mr-2"></ion-icon>
                                Moderation Queue
                                @{
                                    var moderationCount = ViewBag.ModerationCount ?? 0;
                                    if (moderationCount > 0)
                                    {
                                        <span class="bg-red-500 text-white text-xs rounded-full px-2 py-0.5 ml-2">@moderationCount</span>
                                    }
                                }
                            </div>
                        </button>
                        <button class="py-4 px-6 bg-transparent hover:bg-[#eadbf0]/30 text-[#4a3256] font-medium text-center flex-1 focus:outline-none"
                                type="button">
                            <div class="flex justify-center items-center">
                                <ion-icon name="analytics-outline" class="text-xl mr-2"></ion-icon>
                                Content Analysis
                            </div>
                        </button>
                    </div>
                </nav>
                
                <!-- Tab Contents -->
                <div class="uk-switcher" id="admin-tabs">
                    <!-- Tab 1: User Management -->
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-semibold text-[#4a3256]">User Management</h2>
                        </div>
                        
                        <!-- Search Form -->
                        <form asp-controller="Admin" asp-action="SearchUsers" method="get" class="mb-4">
                            <div class="flex items-center">
                                <div class="relative flex-grow">
                                    <input type="text" name="searchTerm" placeholder="Search users by name or email..."
                                           class="w-full px-4 py-2 border border-[#cabeca] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4a3256]"
                                           value="@ViewBag.SearchTerm">
                                    <button type="submit" class="absolute right-2 top-2 text-[#4a3256]">
                                        <ion-icon name="search-outline" class="text-xl"></ion-icon>
                                    </button>
                                </div>
                            </div>
                        </form>
                        
                        <!-- Search Results -->
                        @if (ViewBag.SearchResults != null)
                        {
                            <div class="space-y-4 mt-3">
                                @if (!((IEnumerable<UserWithRolesVM>)ViewBag.SearchResults).Any())
                                {
                                    <div class="bg-[#eadbf0]/50 rounded-lg p-4 text-center">
                                        <ion-icon name="search-outline" class="text-3xl text-[#4a3256] mb-2"></ion-icon>
                                        <p class="text-[#4a3256]">No users found matching your search</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="overflow-x-auto">
                                        <table class="min-w-full bg-white">
                                            <thead class="bg-[#eadbf0]">
                                                <tr>
                                                    <th class="py-2 px-4 text-left text-[#4a3256] font-semibold">Name</th>
                                                    <th class="py-2 px-4 text-left text-[#4a3256] font-semibold">Email</th>
                                                    <th class="py-2 px-4 text-left text-[#4a3256] font-semibold">Role</th>
                                                    <th class="py-2 px-4 text-left text-[#4a3256] font-semibold">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var user in ViewBag.SearchResults)
                                                {
                                                    <tr class="border-b border-[#cabeca]/30 hover:bg-[#eadbf0]/10">
                                                        <td class="py-3 px-4">
                                                            <div class="flex items-center">
                                                                <img src="@Url.Content("~/" + (string.IsNullOrEmpty(user.ProfilePictureUrl) ? "images/avatar/User.png" : user.ProfilePictureUrl))"
                                                                     class="w-8 h-8 rounded-full border border-[#cabeca] mr-3" />
                                                                <span>@user.FullName</span>
                                                            </div>
                                                        </td>
                                                        <td class="py-3 px-4">@user.Email</td>
                                                        <td class="py-3 px-4">
                                                            @foreach (var role in user.Roles)
                                                            {
                                                                <span class="bg-[#eadbf0] text-[#4a3256] px-2 py-1 rounded-full text-xs mr-1">@role</span>
                                                            }
                                                        </td>
                                                        <td class="py-3 px-4">
                                                            <div class="flex items-center space-x-2">
                                                                <form asp-controller="Admin" asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                                    <button type="submit" class="bg-red-100 hover:bg-red-200 text-red-700 px-3 py-1 rounded-lg flex items-center gap-1 transition-colors"
                                                                            @(user.Roles.Contains("Admin") ? "disabled title=\"Cannot delete admin users\"" : "")>
                                                                        <ion-icon name="trash-outline"></ion-icon>
                                                                        Delete
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bg-[#eadbf0]/50 rounded-lg p-6 text-center">
                                <ion-icon name="people-outline" class="text-5xl text-[#4a3256] mb-2"></ion-icon>
                                <p class="text-[#4a3256] text-lg">Enter a name or email to search for users</p>
                            </div>
                        }
                    </div>
                    
                    <!-- Tab 2: Reported Posts -->
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-semibold text-[#4a3256]">Reported Posts</h2>
                        </div>
                        
                        @if (Model == null || !Model.Any())
                        {
                            <div class="bg-[#eadbf0]/50 rounded-lg p-6 text-center">
                                <ion-icon name="checkmark-circle-outline" class="text-5xl text-[#4a3256] mb-2"></ion-icon>
                                <p class="text-[#4a3256] text-lg">No posts have been reported</p>
                            </div>
                        }
                        else
                        {
                            <p class="mb-4">There are <span class="font-bold">@Model.Count</span> posts that have been reported.</p>
                            
                            <div class="space-y-6">
                                @foreach (var post in Model)
                                {
                                    <div class="bg-white rounded-lg shadow-sm p-6 border border-[#cabeca]">
                                        <div class="flex items-center mb-4">
                                            <img src="@Url.Content("~/" + (string.IsNullOrEmpty(post.User?.ProfilePictureUrl) ? "images/avatar/User.png" : post.User.ProfilePictureUrl))" 
                                                 alt="Profile" class="w-10 h-10 rounded-full mr-4">
                                            <div>
                                                <p class="font-semibold">@post.User?.FullName</p>
                                                <p class="text-sm text-gray-500">@post.DateCreated.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                        </div>
                                        
                                        <div class="mb-4">
                                            <p class="text-gray-800">@post.Content</p>
                                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                                            {
                                                <img src="@post.ImageUrl" alt="Post image" class="mt-3 rounded-md max-h-96 w-auto">
                                            }
                                        </div>
                                        
                                        <div class="bg-red-50 p-3 rounded-md mb-4 border border-red-200">
                                            <p class="text-red-700 font-medium">Reported @post.Reports.Count times</p>
                                        </div>
                                        
                                        <div class="flex space-x-3">
                                            <form asp-action="ApprovePost" asp-route-postId="@post.Id" method="post">
                                                <button type="submit" class="bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded">
                                                    Approve & Clear Reports
                                                </button>
                                            </form>
                                            
                                            <form asp-action="DeletePost" asp-route-postId="@post.Id" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this post?');">
                                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded">
                                                    Delete Post
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    
                    <!-- Tab 3: Moderation Queue -->
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-semibold text-[#4a3256]">Content Moderation Queue</h2>
                        </div>
                        
                        @if (ViewBag.ModerationPosts == null || ((IEnumerable<Post>)ViewBag.ModerationPosts).Count() == 0)
                        {
                            <div class="bg-[#eadbf0]/50 rounded-lg p-6 text-center">
                                <ion-icon name="checkmark-circle-outline" class="text-5xl text-[#4a3256] mb-2"></ion-icon>
                                <p class="text-[#4a3256] text-lg">No posts currently awaiting moderation</p>
                            </div>
                        }
                        else
                        {
                            <p class="mb-4">There are <span class="font-bold">@ViewBag.ModerationPosts.Count</span> posts awaiting moderation.</p>
                            
                            <div class="space-y-6">
                                @foreach (var post in ViewBag.ModerationPosts)
                                {
                                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">
                                        <div class="flex items-center mb-4">
                                            <img src="@Url.Content("~/" + (string.IsNullOrEmpty(post.User?.ProfilePictureUrl) ? "images/avatar/User.png" : post.User.ProfilePictureUrl))" 
                                                 alt="Profile" class="w-10 h-10 rounded-full mr-4">
                                            <div>
                                                <p class="font-semibold">@post.User?.FullName</p>
                                                <p class="text-sm text-gray-500">@post.DateCreated.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                        </div>
                                        
                                        <div class="mb-4">
                                            <p class="text-gray-800">@post.Content</p>
                                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                                            {
                                                <img src="@post.ImageUrl" alt="Post image" class="mt-3 rounded-md max-h-96 w-auto">
                                            }
                                        </div>
                                        
                                        <div class="bg-red-50 p-3 rounded-md mb-4 border border-red-200">
                                            <p class="text-red-700 font-medium">Moderation Reason:</p>
                                            <p class="text-gray-800">@(post.ModerationReason ?? "Content flagged for review")</p>
                                        </div>
                                        
                                        <div class="flex space-x-3">
                                            <form asp-action="ApproveModeratedPost" asp-route-postId="@post.Id" method="post">
                                                <button type="submit" class="bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded">
                                                    Approve Post
                                                </button>
                                            </form>
                                            
                                            <form asp-action="RejectModeratedPost" asp-route-postId="@post.Id" method="post"
                                                  onsubmit="return confirm('Are you sure you want to reject and delete this post?');">
                                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded">
                                                    Reject Post
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    
                    <!-- Tab 4: Content Analysis -->
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-semibold text-[#4a3256]">Content Analysis Tester</h2>
                        </div>
                        
                        <form asp-controller="Admin" asp-action="TestContentAnalysis" method="post" id="content-analysis-form">
                            <div class="mb-4">
                                <label for="Content" class="block text-[#4a3256] font-medium mb-2">Content to Analyze:</label>
                                <textarea name="Content" id="Content" rows="5"
                                        class="w-full px-3 py-2 border border-[#cabeca] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4a3256]"
                                        placeholder="Enter text to analyze its interests...">@(ViewBag.ContentAnalysisModel?.Content ?? "")</textarea>
                            </div>
                            <button type="submit" class="bg-[#4a3256] hover:bg-[#3a2644] text-white px-4 py-2 rounded-lg transition-all">
                                Analyze Content
                            </button>
                        </form>
                        
                        <!-- Results Section -->
                        @if (ViewBag.ContentAnalysisModel?.Results != null && ((IEnumerable<InterestScore>)ViewBag.ContentAnalysisModel.Results).Any())
                        {
                            <div class="mt-6">
                                <h3 class="text-lg font-semibold text-[#4a3256] mb-4">Analysis Results</h3>
                                
                                <div class="overflow-x-auto">
                                    <table class="min-w-full">
                                        <thead class="border-b border-[#cabeca]">
                                            <tr>
                                                <th class="py-2 px-4 text-left text-[#4a3256] font-medium">Interest</th>
                                                <th class="py-2 px-4 text-left text-[#4a3256] font-medium">Score</th>
                                                <th class="py-2 px-4 text-left text-[#4a3256] font-medium">Relevant Keywords</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var result in ((IEnumerable<InterestScore>)ViewBag.ContentAnalysisModel.Results).OrderByDescending(r => r.Score))
                                            {
                                                <tr class="border-b border-[#cabeca] hover:bg-[#eadbf0]/20 transition-colors">
                                                    <td class="py-3 px-4 text-[#4a3256]">@result.Interest</td>
                                                    <td class="py-3 px-4 text-[#4a3256]">
                                                        <div class="flex items-center">
                                                            <div class="h-2 w-24 bg-gray-200 rounded overflow-hidden mr-2">
                                                                <div class="h-full bg-[#4a3256]" style="width: @(result.Score * 100)%"></div>
                                                            </div>
                                                            <span>@((result.Score * 100).ToString("F1"))%</span>
                                                        </div>
                                                    </td>
                                                    <td class="py-3 px-4 text-[#4a3256]">
                                                        <div class="flex flex-wrap gap-1">
                                                            @foreach (var keyword in result.Keywords.Split(',').Take(5))
                                                            {
                                                                <span class="bg-[#eadbf0] text-[#4a3256] text-xs px-2 py-1 rounded-full">@keyword</span>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@if (TempData["SuccessMessage"] != null)
{
    <div class="fixed bottom-5 right-5 bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-lg" 
         id="success-alert" role="alert">
        <p>@TempData["SuccessMessage"]</p>
    </div>
    
    <script>
        setTimeout(function() {
            document.getElementById('success-alert').style.display = 'none';
        }, 5000);
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="fixed bottom-5 right-5 bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded shadow-lg"
         id="error-alert" role="alert">
        <p>@TempData["ErrorMessage"]</p>
    </div>
    
    <script>
        setTimeout(function() {
            document.getElementById('error-alert').style.display = 'none';
        }, 5000);
    </script>
}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Set active tab based on URL parameter or ViewBag
        const activeTab = @(ViewBag.ActiveTab ?? 0);
        const switcher = UIkit.switcher(document.querySelector('[uk-switcher]'));
        if (switcher) {
            switcher.show(activeTab);
        }
        
        // Make sure form in content analysis tab works properly
        document.getElementById('content-analysis-form').addEventListener('submit', function(e) {
            // Let the form submit normally but ensure the content field is included
            const contentField = document.getElementById('Content');
            if (contentField.value.trim() === '') {
                e.preventDefault();
                alert('Please enter some content to analyze.');
            }
        });
    });
</script>